# Windows door agent only. Copy to .env.bridge beside compose.windows.yml.

# Public HTTPS URL of the existing Railway bot (no trailing slash).
BRIDGE_SERVER_URL=https://your-service.up.railway.app

# The same random 64-character value configured as DOOR_BRIDGE_TOKEN on Railway.
# Generate with a cryptographically secure PowerShell command:
#   $b=[byte[]]::new(32); $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); -join ($b|%{$_.ToString('x2')})
DOOR_BRIDGE_TOKEN=
DOOR_BRIDGE_AGENT_ID=building-pc

# Inside compose.windows.yml, the Home Assistant container is reachable by its
# service name. Do not change this to localhost for the container deployment.
HOME_ASSISTANT_URL=http://home-assistant:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_FRONT_ENTITY_ID=switch.porte_immeuble_switch_1

HOME_ASSISTANT_TIMEOUT_MS=5000
BRIDGE_REQUEST_TIMEOUT_MS=30000
BRIDGE_RETRY_MAX_MS=15000
MAX_RELAY_PULSE_MS=2000
