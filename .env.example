# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Holds the whitelist, the audit log, AND the WhatsApp session (RemoteAuth stores
# it in GridFS). Treat this connection string as a credential: anyone who can
# read this database can impersonate the bot's WhatsApp account.
MONGODB_URI=mongodb://localhost:27017/mindsept

# --- Admin panel --------------------------------------------------------------
# Shared password for the panel, and the secret its session cookie is signed with.
# Generate the secret with: openssl rand -base64 32
# ADMIN_PASSWORD only sets the password on FIRST boot (it's hashed into Mongo
# from there). After that, change it from Settings -> Admin password; editing
# this var has no further effect.
# SESSION_SECRET also encrypts AI provider keys saved through the dashboard.
# Keep it stable. If you rotate it, sign in again and replace those keys.
ADMIN_PASSWORD=
SESSION_SECRET=

# How long a panel login lasts. Defaults to 30 days: the panel is installed to a
# phone's home screen to receive door alerts, and iOS gives an installed app its
# own cookie jar, so a short session means re-authenticating on the very device
# you need to answer from. Lower it if the panel is only used from a desktop.
# ADMIN_SESSION_MAX_AGE_MS=2592000000

# --- Door provider ------------------------------------------------------------
# Recommended production split: the Railway bot queues an atomic pulse for the
# Windows door agent, which polls Railway over outbound HTTPS. The PC needs no
# public IP or inbound port. Use one random 32-byte token on both sides.
DOOR_PROVIDER=bridge
DOOR_BRIDGE_TOKEN=
DOOR_BRIDGE_AGENT_ID=building-pc
# BRIDGE_HEARTBEAT_TTL_MS=45000
# BRIDGE_CLAIM_TIMEOUT_MS=5000
# BRIDGE_RESULT_TIMEOUT_MS=30000
# BRIDGE_POLL_WAIT_MS=20000

# Direct Home Assistant mode is useful for development when the whole bot and
# Home Assistant run on one machine. In production these values belong only in
# the Windows PC's .env.bridge file, never in Railway.
# HOME_ASSISTANT_URL=http://127.0.0.1:8123
# HOME_ASSISTANT_TOKEN=
# HOME_ASSISTANT_FRONT_ENTITY_ID=switch.porte_immeuble_switch_1
# HOME_ASSISTANT_TIMEOUT_MS=5000

# Legacy Tuya IoT Core provider. These are required only with
# DOOR_PROVIDER=tuya and can stay unset when another provider is selected.
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
# TUYA_REGION=eu
# DOOR_FRONT_DEVICE_ID=

# Relay behavior: how long (ms) to hold the switch "on" before switching it back off.
# Confirmed via device logs: the physical relay is a momentary pulse, ~1s.
# The admin panel can override this at runtime.
RELAY_PULSE_MS=1000

# Before pulsing, the bot asks the active provider whether the relay is
# reachable. One "offline" reading can be stale, so this is how long to wait
# before asking a second time.
DOOR_OFFLINE_RECHECK_MS=3000

# After pulsing, the bot reads the relay's own reported switch state back to see
# whether it actually moved. A successful API response only proves the provider
# accepted the command, so this readback is the closest same-second evidence an
# open really happened.
#
# Home Assistant defaults this off: Tuya's cloud-pushed state can arrive after
# the one-second pulse and falsely report a successful open as a failure. The
# legacy direct Tuya provider defaults it on. A verification read is always
# bounded by the pulse deadline so it can never delay the safety OFF command.
# DOOR_VERIFY=off
DOOR_VERIFY_DELAY_MS=500

# Web Push, for "the door is offline" alerts on the admin's phone.
# A working pair is already baked into src/config.js so a fresh deploy needs no
# setup. Set these only to override it - which you must do if this repo ever
# stops being private. Generate a new pair with: npm run keys:vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@mindsept.local

# The inner door ("porte Mind7") is a smart lock (category "jtmspro"), not a plain
# switch - it has no simple DP for remote unlock and needs Tuya's separate
# ticket-based Smart Lock API. Not implemented yet - see README.

# --- WhatsApp -----------------------------------------------------------------
# Distinguishes sessions that share one database (e.g. staging vs production).
WA_CLIENT_ID=mindsept

# How often RemoteAuth backs the session up to Mongo. Minimum 60000.
WA_BACKUP_SYNC_INTERVAL_MS=300000

# Local scratch dir RemoteAuth zips the session from before uploading. Ephemeral
# by design - do not put this on a volume expecting it to be the source of truth.
WA_DATA_PATH=/tmp/.wwebjs_auth

# Optional: seeds the door group on FIRST boot only. After that the admin panel
# (Settings -> The door group) is the source of truth.
WA_GROUP_ID=

# Optional: country code prepended to member phone numbers typed in national
# format, so "0549212025" is stored as "213549212025". Seeds the setting on
# FIRST boot only; after that it lives in Settings -> Phone numbers.
# Defaults to 213 (Algeria).
DEFAULT_COUNTRY_CODE=213

# --- Optional AI helpers ------------------------------------------------------
# AI can vary group replies and, when explicitly enabled in the dashboard,
# conservatively recognize natural-language door requests from whitelisted
# members. It never decides authorization or the door result. Exact commands
# and fixed replies continue working when no provider is configured or the API
# is down.
#
# Recommended: choose OpenAI or Gemini and save its key under Settings -> AI in
# group chats. Dashboard keys are encrypted in Mongo and are never returned to
# the browser. The environment keys below are optional deployment fallbacks.
# AI_PROVIDER only seeds the provider on a fresh database; afterwards the
# dashboard setting owns it.
AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Backwards-compatible name for OPENAI_MODEL:
# AI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Hard timeout for one classification/reply request. There are no retries.
# AI_TIMEOUT_MS=1500

# Path to Chromium. Leave unset locally (Puppeteer's bundled build is used); the
# Dockerfile sets it to /usr/bin/chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
