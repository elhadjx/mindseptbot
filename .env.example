# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Holds the whitelist, the audit log, AND the WhatsApp session (RemoteAuth stores
# it in GridFS). Treat this connection string as a credential: anyone who can
# read this database can impersonate the bot's WhatsApp account.
MONGODB_URI=mongodb://localhost:27017/mindsept

# --- Admin panel --------------------------------------------------------------
# Shared password for the panel, and the secret its session cookie is signed with.
# Generate the secret with: openssl rand -base64 32
# ADMIN_PASSWORD only sets the password on FIRST boot (it's hashed into Mongo
# from there). After that, change it from Settings -> Admin password; editing
# this var has no further effect.
ADMIN_PASSWORD=
SESSION_SECRET=

# How long a panel login lasts. Defaults to 30 days: the panel is installed to a
# phone's home screen to receive door alerts, and iOS gives an installed app its
# own cookie jar, so a short session means re-authenticating on the very device
# you need to answer from. Lower it if the panel is only used from a desktop.
# ADMIN_SESSION_MAX_AGE_MS=2592000000

# --- Tuya Cloud API -----------------------------------------------------------
# Credentials from the Tuya IoT Platform (Cloud -> [project] -> Overview tab).
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Data center region code matching your Cloud Project: cn, us, us-e, eu, eu-w, in.
TUYA_REGION=eu

# Front door ("Porte immeuble") - a plain relay switch (Tuya category "kg").
# This is the sub-device's own id (Devices -> All Devices) - cloud commands
# address it directly, no gateway/local-key involved.
DOOR_FRONT_DEVICE_ID=

# Relay behavior: how long (ms) to hold the switch "on" before switching it back off.
# Confirmed via device logs: the physical relay is a momentary pulse, ~1s.
# The admin panel can override this at runtime.
RELAY_PULSE_MS=1000

# Before pulsing, the bot asks Tuya whether the relay is reachable. Tuya marks a
# device offline on a heartbeat timeout, so one "offline" reading is often just a
# gap - this is how long to wait before asking a second time.
DOOR_OFFLINE_RECHECK_MS=3000

# Web Push, for "the door is offline" alerts on the admin's phone.
# A working pair is already baked into src/config.js so a fresh deploy needs no
# setup. Set these only to override it - which you must do if this repo ever
# stops being private. Generate a new pair with: npm run keys:vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@mindsept.local

# The inner door ("porte Mind7") is a smart lock (category "jtmspro"), not a plain
# switch - it has no simple DP for remote unlock and needs Tuya's separate
# ticket-based Smart Lock API. Not implemented yet - see README.

# --- WhatsApp -----------------------------------------------------------------
# Distinguishes sessions that share one database (e.g. staging vs production).
WA_CLIENT_ID=mindsept

# How often RemoteAuth backs the session up to Mongo. Minimum 60000.
WA_BACKUP_SYNC_INTERVAL_MS=300000

# Local scratch dir RemoteAuth zips the session from before uploading. Ephemeral
# by design - do not put this on a volume expecting it to be the source of truth.
WA_DATA_PATH=/tmp/.wwebjs_auth

# Optional: seeds the door group on FIRST boot only. After that the admin panel
# (Settings -> The door group) is the source of truth.
WA_GROUP_ID=

# Optional: country code prepended to member phone numbers typed in national
# format, so "0549212025" is stored as "213549212025". Seeds the setting on
# FIRST boot only; after that it lives in Settings -> Phone numbers.
# Defaults to 213 (Algeria).
DEFAULT_COUNTRY_CODE=213

# Path to Chromium. Leave unset locally (Puppeteer's bundled build is used); the
# Dockerfile sets it to /usr/bin/chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
